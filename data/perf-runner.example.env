# 复制为环境变量后启动本地后端：python backend/app.py

# Cloudflare 队列 Relay（仅主动出站连接，不开放监听端口）
RUNNER_API_BASE=https://flash-linear-attention-npu-io-fazhenyao.fazhenyao.workers.dev
RUNNER_ID=vpn-runner-01
RUNNER_NAME=VPN Runner 01
RUNNER_TOKEN=replace-with-worker-runner-token
RUNNER_POLL_MIN_SECONDS=2
RUNNER_POLL_MAX_SECONDS=30
RUNNER_ERROR_BACKOFF_MAX_SECONDS=120
RUNNER_HEARTBEAT_SECONDS=15
RUNNER_MAX_CONCURRENCY=1
RUNNER_STATE_DIR=data/runner-state
RUNNER_ARTIFACT_RETENTION_DAYS=30
RUNNER_ARTIFACT_ROOTS=data/prof_gdr;data/prof_op
# R2 multipart 上传分片大小；需至少 5 MiB，默认 32 MiB。
RUNNER_R2_PART_MIB=32
# 多 Agent 实例必须使用不同的 RUNNER_ID、RUNNER_STATE_DIR、日志和本地制品目录。

# SSH 到 NPU 主机执行（推荐）
PERF_RUN_MODE=ssh
PERF_SSH_HOST=your-npu-host
PERF_SSH_USER=your-user
PERF_REMOTE_WORKDIR=.
# 可信的 Relay 本机配置可将看板白名单脚本映射到 NPU 主机上的绝对路径
PERF_REMOTE_SCRIPT=scripts/flash_gated_delta_rule.py
# 非交互 SSH 不加载 Ascend 环境时，配置可信的远端环境脚本
PERF_REMOTE_ENV_SCRIPT=/usr/local/Ascend/ascend-toolkit/set_env.sh
# 环境脚本未暴露 profiling 工具时，仅追加所需工具目录
# PERF_REMOTE_PATH_PREPEND=/usr/local/Ascend/ascend-toolkit/latest/tools/profiler/bin:/usr/local/Ascend/ascend-toolkit/latest/tools/msopt/bin
# 需要 Conda Python 环境时，显式加载初始化脚本并激活环境
# PERF_REMOTE_CONDA_SH=/data/miniconda3/etc/profile.d/conda.sh
# PERF_REMOTE_CONDA_ENV=fla_dump
PERF_NPU_DEVICE=2
PERF_CHIP=A2
PERF_PROF_OUTPUT=data/prof_gdr
PERF_OP_OUTPUT=data/prof_op
# 多 Agent 部署时为每个实例配置独立的本地回收目录
PERF_LOCAL_PROF_OUTPUT=data/prof_gdr
PERF_LOCAL_OP_OUTPUT=data/prof_op
PERF_SOC_VERSION=Ascend910B

# 若 IO 后端直接跑在 NPU 主机上：
# PERF_RUN_MODE=local
# PERF_LOCAL_SCRIPT=scripts/flash_gated_delta_rule.py

# 仅打印命令、不实际执行：
# PERF_RUN_DRY_RUN=1

# 采集模式说明（看板触发时选择，不可并行）：
# - msprof        → PROF_*     → data/prof_gdr  → import_prof_gdr.py
# - msopprof       → OPPROF_*   → data/prof_op   → import_msprof_op.py
# - msopprof sim   → OPPROF_*   → data/prof_op   → import_msprof_op.py
# msopprof 多 kernel 示例：--kernel-name="ChunkGatedDeltaRuleFwdH|ChunkFwdO"
# PERF_OP_WARM_UP=10
# PERF_OP_LAUNCH_COUNT=10
